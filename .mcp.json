{
  "mcpServers": {
    "3XPRES5 CENTOS STREAM": {
      "command": "docker",
      "args": [
        "run",services:
  etcd:
    image: bitnami/etcd:3.5.13
    ports:
      - 2379:2379
      - 2380:2380
    env:
      ALLOW_NONE_AUTHENTICATION: yes
      ETCD_ADVERTISE_CLIENT_URLS: http://0.0.0.0:2379
        "--rm",
        "-i",
        "-e",
        "PAYROLL_PROCESSOR=/workspace/tools/payroll/process_payroll_entries.py",
        "-v",
        ".:/workspace",
        "-w",
        "/workspace",
        "quay.io/centos/centos:stream9",
        "bash",
        "-lc",
        "npx -y @modelcontextprotocol/server-filesystem /workspace"
      ]
    }
  }
}
