{
  "mcpServers": {
    "3XPRES5 CENTOS STREAM": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e",
        "PAYROLL_PROCESSOR=/workspace/tools/payroll/process_payroll_entries.py",
        "-v",
        ".:/workspace",
        "-w",
        "/workspace",
        "quay.io/centos/centos:stream9",
        "bash",
        "-lc",
        "npx -y @modelcontextprotocol/server-filesystem /workspace"
      ]
    }
  }
}
